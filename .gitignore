# Build output
/build/
*.o
*.obj

# Compiled binaries produced by the Makefile
/parallelcrack
/bin/

# Locally generated benchmark artifacts (never commit machine-specific runs):
# CSVs, plots, metadata, result archives, and SLURM .out/.err logs all land in
# results/. Ignore everything there except the explanatory README.
results/*
!results/README.md

# Synthetic encrypted test files generated at runtime
*.enc
tests/tmp/

# SLURM output files
slurm-*.out
*.sbatch.log

# Editor / OS noise
.DS_Store
*.swp
compile_commands.json
